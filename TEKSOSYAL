  <span class="logo">TEKSOSYAL</span>
  <button class="on" data-p="app">Uygulama</button>
  <button data-p="web">Web</button>
  <button data-p="admin">Yönetim Paneli</button>
</div>
<div class="page on" id="page-app">
<div class="tk" style="font-family:var(--kimi-font-sans);max-width:380px;width:100%">
<div class="phone">
  <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 16px 2px;font-size:12px;font-weight:500;color:var(--kimi-color-text-secondary)">
