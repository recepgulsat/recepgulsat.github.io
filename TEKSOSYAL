.adm td{padding:8px;border-bottom:1px solid var(--kimi-color-border);color:var(--kimi-color-text-secondary)}

body{margin:0;background:#26272b;padding:12px;display:flex;flex-direction:column;align-items:center}
.topnav{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;padding:6px 10px;margin-bottom:12px;border:1px solid #3a3b40;border-radius:9999px;background:#1d1e22}
