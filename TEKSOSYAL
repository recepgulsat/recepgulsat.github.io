      <svg width="20" height="12" viewBox="0 0 26 14" fill="none" stroke="currentColor"><rect x="1" y="1.5" width="20" height="11" rx="3" stroke-width="1.2"/><rect x="3" y="3.5" width="13" height="7" rx="1.5" fill="currentColor" stroke="none"/><path d="M23.5 5v4" stroke-width="1.6" stroke-linecap="round"/></svg>
