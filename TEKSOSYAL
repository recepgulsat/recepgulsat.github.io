<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TEKSOSYAL — Tam Paket</title>
<style>
:root{
--kimi-font-sans:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',sans-serif;
--kimi-color-surface:#ffffff;
--kimi-color-surface-muted:#f2f3f5;
--kimi-color-surface-strong:#191a1c;
--kimi-color-text-primary:#1a1b1d;
--kimi-color-text-secondary:#54575c;
--kimi-color-text-tertiary:#93969c;
--kimi-color-text-quaternary:#c2c5ca;
--kimi-color-border:#e4e5e8;
--kimi-color-accent:#2f6bff;
--kimi-color-danger:#e5484d;
--kimi-color-positive:#2f9e6e;
--kimi-color-warning:#f5a524;
--kimi-chart-1:#2f6bff;--kimi-chart-2:#2f9e6e;--kimi-chart-3:#f5a524;--kimi-chart-4:#8e4ec6;--kimi-chart-5:#e5484d;
--t-fast:.15s;--t-normal:.3s;--t-slow:.5s;--ease-out:cubic-bezier(.22,.61,.36,1);
}
@media (prefers-color-scheme:dark){
:root{
--kimi-color-surface:#16171a;
--kimi-color-surface-muted:#22242a;
--kimi-color-surface-strong:#000000;
--kimi-color-text-primary:#f2f3f5;
--kimi-color-text-secondary:#b0b3b8;
--kimi-color-text-tertiary:#7d8087;
--kimi-color-text-quaternary:#4a4d54;
--kimi-color-border:#2a2c31;
}}
body{margin:0;background:#26272b;padding:28px 12px;display:flex;justify-content:center}
.tk *{box-sizing:border-box;margin:0}
.tk button{font:inherit;background:none;border:none;cursor:pointer;color:inherit;padding:0}
.tk .view{display:none}
.tk .view.active{display:block}
.tk .phone{position:relative;border:1px solid var(--kimi-color-border);border-radius:16px;overflow:hidden;background:var(--kimi-color-surface)}
.tk .tabbtn{display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 0 4px;font-size:12px;color:var(--kimi-color-text-tertiary);flex:1;transition:color var(--t-fast) var(--ease-out)}
.tk .tabbtn.active{color:var(--kimi-color-text-primary)}
.tk .avatar{border-radius:9999px;display:flex;align-items:center;justify-content:center;font-weight:500;flex:none;position:relative}
.tk .likebtn{display:flex;align-items:center;gap:6px;color:var(--kimi-color-text-secondary);font-size:14px;font-variant-numeric:tabular-nums}
.tk .likebtn.liked{color:var(--kimi-color-danger)}
.tk .likebtn.liked svg{fill:var(--kimi-color-danger)}
.tk .tabbar{display:flex;position:relative;z-index:10;background:var(--kimi-color-surface);box-shadow:0 -1px 6px color-mix(in srgb,var(--kimi-color-text-primary) 7%,transparent)}
.tk .card{border-bottom:1px solid var(--kimi-color-border);padding:12px 16px}
.tk .bub{max-width:78%;padding:8px 12px;border-radius:16px;font-size:14px;line-height:20px;display:flex;flex-direction:column;gap:4px;cursor:pointer}
.tk .bub.in{background:color-mix(in srgb,var(--kimi-chart-1) 9%,var(--kimi-color-surface-muted));border-bottom-left-radius:4px;align-self:flex-start}
.tk .bub.out{background:var(--kimi-chart-1);color:#fff;border-bottom-right-radius:4px;align-self:flex-end}
.tk .qline{font-size:11px;opacity:.75;border-left:2px solid currentColor;padding-left:8px;line-height:15px}
.tk .chatrow{display:flex;align-items:center;gap:12px;padding:10px 16px;cursor:pointer}
.tk .chatrow:hover{background:var(--kimi-color-surface-muted)}
.tk .storyring{padding:2px;border-radius:9999px;background:var(--kimi-chart-2);cursor:pointer;flex:none}
.tk .storyring.seen{background:var(--kimi-color-border)}
.tk .livering{padding:2px;border-radius:9999px;background:var(--kimi-color-danger);cursor:pointer;flex:none}
.tk .tile{border-radius:8px;display:flex;align-items:center;justify-content:center}
.tk .sheet{position:absolute;left:0;right:0;bottom:0;transform:translateY(102%);transition:transform var(--t-normal) var(--ease-out);z-index:40;background:var(--kimi-color-surface);border-radius:12px 12px 0 0;border-top:1px solid var(--kimi-color-border);max-height:72%;display:flex;flex-direction:column}
.tk .sheet.open{transform:translateY(0)}
.tk .panel{position:absolute;top:0;bottom:0;right:0;width:82%;background:var(--kimi-color-surface);border-left:1px solid var(--kimi-color-border);transform:translateX(102%);transition:transform var(--t-normal) var(--ease-out);z-index:50;display:flex;flex-direction:column}
.tk .panel.open{transform:translateX(0)}
.tk .storyfull{position:absolute;inset:0;background:var(--kimi-color-surface-strong);z-index:60;display:none;flex-direction:column;color:var(--kimi-color-surface)}
.tk .storyfull.open{display:flex}
.tk .seg{flex:1;height:3px;border-radius:9999px;background:color-mix(in srgb,var(--kimi-color-surface) 30%,transparent);overflow:hidden}
.tk .seg>i{display:block;height:100%;width:0;background:var(--kimi-color-surface)}
.tk .seg.on>i{width:100%}
.tk .seg.cur>i{transition:width 5s linear;width:100%}
.tk .pollopt{border:1px solid var(--kimi-color-border);border-radius:8px;padding:8px 12px;margin-top:8px;cursor:pointer;position:relative;overflow:hidden}
.tk .pollopt .fill{position:absolute;inset:0;background:color-mix(in srgb,var(--kimi-chart-1) 12%,transparent);width:0;transition:width var(--t-normal) var(--ease-out)}
.tk .pollopt.voted{border-color:var(--kimi-chart-1)}
.tk .pollopt.locked{opacity:.55;cursor:default}
.tk .reels{height:406px;overflow-y:auto;scroll-snap-type:y mandatory}
.tk .reels::-webkit-scrollbar{display:none}
.tk .reel{height:100%;scroll-snap-align:start;position:relative;flex:none}
.tk .followbtn{font-size:12px;border:1px solid currentColor;border-radius:9999px;padding:2px 10px}
.tk .followbtn.on{opacity:.65}
.tk .mini-like.liked{color:var(--kimi-color-danger)}
.tk .mini-like.liked svg{fill:var(--kimi-color-danger)}
.tk .scr{position:absolute;inset:0;z-index:70;background:var(--kimi-color-surface);transform:translateX(102%);transition:transform var(--t-normal) var(--ease-out);display:flex;flex-direction:column}
.tk .scr.open{transform:none}
.tk .scrdark{background:var(--kimi-color-surface-strong);color:var(--kimi-color-surface)}
.tk .scrhead{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--kimi-color-border);flex:none}
.tk .scrdark .scrhead{border-bottom-color:color-mix(in srgb,var(--kimi-color-surface) 20%,transparent)}
.tk .sback{padding:4px;color:var(--kimi-color-text-secondary);flex:none}
.tk .scrdark .sback{color:var(--kimi-color-surface)}
.tk .lrow{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--kimi-color-border);cursor:pointer}
.tk .lrow:hover{background:var(--kimi-color-surface-muted)}
.tk .chip{flex:none;font-size:12px;border:1px solid var(--kimi-color-border);border-radius:9999px;padding:4px 12px;color:var(--kimi-color-text-secondary);cursor:pointer}
.tk .chip.on{background:var(--kimi-chart-1);color:#fff;border-color:var(--kimi-chart-1)}
.tk .switch{width:42px;height:24px;border-radius:9999px;background:color-mix(in srgb,var(--kimi-color-text-primary) 25%,transparent);position:relative;transition:background var(--t-fast);flex:none}
.tk .switch>i{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:9999px;background:var(--kimi-color-surface);transition:left var(--t-fast);box-shadow:0 1px 3px rgba(0,0,0,.25)}
.tk .switch.on{background:var(--kimi-chart-1)}
.tk .switch.on>i{left:21px}
.tk .radio{width:18px;height:18px;border-radius:9999px;border:2px solid var(--kimi-color-border);flex:none;display:flex;align-items:center;justify-content:center}
.tk .radio.on{border-color:var(--kimi-chart-1)}
.tk .radio.on::after{content:'';width:9px;height:9px;border-radius:9999px;background:var(--kimi-chart-1)}
.tk .toast{position:absolute;left:50%;bottom:96px;transform:translate(-50%,14px);background:#323232;color:#fff;font-size:13px;padding:8px 16px;border-radius:8px;opacity:0;transition:all var(--t-fast) var(--ease-out);z-index:95;pointer-events:none;white-space:nowrap;max-width:92%;overflow:hidden;text-overflow:ellipsis}
.tk .toast.show{opacity:1;transform:translate(-50%,0)}
.tk .wave{display:flex;align-items:center;gap:2px;height:22px}
.tk .wave i{width:3px;border-radius:2px;background:currentColor;opacity:.85}
.tk .floatheart{position:absolute;right:24px;bottom:70px;color:var(--kimi-color-danger);animation:tkup 1.6s var(--ease-out) forwards}
@keyframes tkup{0%{transform:translateY(0);opacity:1}100%{transform:translateY(-160px);opacity:0}}
.tk .recpulse{animation:tkpulse 1s infinite}
@keyframes tkpulse{0%,100%{opacity:1}50%{opacity:.35}}
.tk .scrub{width:100%;accent-color:var(--kimi-color-surface);height:16px;cursor:pointer}
.tk .imgpick{width:64px;height:64px;border-radius:8px;cursor:pointer;border:2px solid transparent}
.tk .imgpick.on{border-color:var(--kimi-chart-1)}
.tk .cinput{flex:1;border:1px solid var(--kimi-color-border);border-radius:9999px;padding:8px 16px;font-size:14px;background:transparent;color:var(--kimi-color-text-primary);outline:none;font-family:inherit;min-width:0}
.tk .cbtn{display:flex;align-items:center;gap:6px;font-size:13px;border:1px solid var(--kimi-color-border);border-radius:9999px;padding:6px 14px}
.tk .fadeout{opacity:0;transition:opacity var(--t-normal)}
.tk .clipchip{height:44px;border-radius:8px;background:color-mix(in srgb,var(--kimi-color-surface) 22%,transparent);display:flex;align-items:flex-end;justify-content:center;padding-bottom:3px;font-size:10px;flex:none;position:relative;overflow:hidden}
.tk .clipchip>i{position:absolute;left:0;bottom:0;top:0;background:color-mix(in srgb,var(--kimi-color-surface) 35%,transparent)}
.tk .fab{position:absolute;right:16px;bottom:118px;width:52px;height:52px;border-radius:16px;background:var(--kimi-chart-1);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px color-mix(in srgb,var(--kimi-chart-1) 45%,transparent);z-index:15;transition:transform var(--t-fast) var(--ease-out)}
.tk .fab:active{transform:scale(.92)}
.tk .navbar{display:flex;justify-content:center;gap:64px;padding:8px 0 10px;background:var(--kimi-color-surface);box-shadow:0 -1px 6px color-mix(in srgb,var(--kimi-color-text-primary) 7%,transparent);position:relative;z-index:10}
.tk .navkey{width:28px;height:28px;display:flex;align-items:center;justify-content:center;color:var(--kimi-color-text-secondary);border-radius:9999px}
.tk .navkey:active{background:var(--kimi-color-surface-muted)}
.tw *{box-sizing:border-box;margin:0}
.tw button{font:inherit;background:none;border:none;cursor:pointer;color:inherit;padding:0}
.tw .wpanel{border:1px solid var(--kimi-color-border);border-radius:16px;overflow:hidden;background:var(--kimi-color-surface);display:flex;height:640px;position:relative}
.tw .rail{width:66px;border-right:1px solid var(--kimi-color-border);display:flex;flex-direction:column;align-items:center;padding:16px 0;gap:8px;flex:none}
.tw .ric{width:42px;height:42px;border-radius:9999px;display:flex;align-items:center;justify-content:center;color:var(--kimi-color-text-secondary);transition:all var(--t-fast) var(--ease-out)}
.tw .ric:hover{background:var(--kimi-color-surface-muted);color:var(--kimi-color-text-primary)}
.tw .ric.on{color:var(--kimi-color-text-primary)}
.tw .view{display:none}
.tw .view.on{display:block}
.tw .avatar{border-radius:9999px;display:flex;align-items:center;justify-content:center;font-weight:500;flex:none;position:relative}
.tw .storyring{padding:2px;border-radius:9999px;background:var(--kimi-chart-2);cursor:pointer;flex:none}
.tw .storyring.seen{background:var(--kimi-color-border)}
.tw .card{border:1px solid var(--kimi-color-border);border-radius:12px;padding:12px 14px;margin-bottom:14px}
.tw .likebtn{display:flex;align-items:center;gap:6px;color:var(--kimi-color-text-secondary);font-size:13px;font-variant-numeric:tabular-nums}
.tw .likebtn.liked{color:var(--kimi-color-danger)}
.tw .likebtn.liked svg{fill:var(--kimi-color-danger)}
.tw .chip{font-size:11px;border:1px solid var(--kimi-color-border);border-radius:9999px;padding:3px 10px;color:var(--kimi-color-text-secondary);cursor:pointer;flex:none}
.tw .chip.on{background:var(--kimi-color-text-primary);color:var(--kimi-color-surface);border-color:var(--kimi-color-text-primary)}
.tw .tile{border-radius:8px;display:flex;align-items:center;justify-content:center}
.tw .lrow{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--kimi-color-border);cursor:pointer}
.tw .lrow:hover{background:var(--kimi-color-surface-muted)}
.tw .bub{max-width:75%;padding:8px 12px;border-radius:16px;font-size:13px;line-height:18px}
.tw .bub.in{background:var(--kimi-color-surface-muted);border-bottom-left-radius:4px;align-self:flex-start}
.tw .bub.out{background:var(--kimi-color-text-primary);color:var(--kimi-color-surface);border-bottom-right-radius:4px;align-self:flex-end}
.tw .toast{position:absolute;left:50%;bottom:18px;transform:translate(-50%,14px);background:var(--kimi-color-text-primary);color:var(--kimi-color-surface);font-size:13px;padding:8px 16px;border-radius:9999px;opacity:0;transition:all var(--t-fast) var(--ease-out);z-index:95;pointer-events:none;white-space:nowrap}
.tw .toast.show{opacity:1;transform:translate(-50%,0)}
.tw .searchpanel{position:absolute;left:66px;top:0;bottom:0;width:300px;background:var(--kimi-color-surface);border-right:1px solid var(--kimi-color-border);z-index:40;transform:translateX(-110%);transition:transform var(--t-normal) var(--ease-out);display:flex;flex-direction:column}
.tw .searchpanel.open{transform:none}
.tw .cinput{flex:1;border:1px solid var(--kimi-color-border);border-radius:9999px;padding:7px 14px;font-size:13px;background:transparent;color:var(--kimi-color-text-primary);outline:none;font-family:inherit;min-width:0}
.tw .followbtn{font-size:11px;font-weight:500;color:var(--kimi-color-text-primary);flex:none}
.adm *{box-sizing:border-box;margin:0}
.adm button{font:inherit;background:none;border:none;cursor:pointer;color:inherit;padding:0}
.adm .apanel{border:1px solid var(--kimi-color-border);border-radius:16px;overflow:hidden;background:var(--kimi-color-surface);display:flex;height:660px;position:relative}
.adm .aside{width:190px;border-right:1px solid var(--kimi-color-border);display:flex;flex-direction:column;flex:none}
.adm .nav{display:flex;align-items:center;gap:10px;padding:9px 14px;font-size:13px;color:var(--kimi-color-text-secondary);border-radius:8px;margin:1px 8px;text-align:left;transition:all var(--t-fast) var(--ease-out)}
.adm .nav:hover{background:var(--kimi-color-surface-muted)}
.adm .nav.on{background:var(--kimi-color-surface-muted);color:var(--kimi-color-text-primary);font-weight:500}
.adm .aview{display:none}
.adm .aview.on{display:block}
.adm .kpi{border:1px solid var(--kimi-color-border);border-radius:10px;padding:12px 14px;flex:1;min-width:0}
.adm .lrow{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--kimi-color-border)}
.adm .chip{font-size:11px;border:1px solid var(--kimi-color-border);border-radius:9999px;padding:3px 10px;color:var(--kimi-color-text-secondary);cursor:pointer;flex:none}
.adm .chip.on{background:var(--kimi-color-text-primary);color:var(--kimi-color-surface);border-color:var(--kimi-color-text-primary)}
.adm .badge{font-size:10px;font-weight:500;border-radius:6px;padding:2px 8px;flex:none;white-space:nowrap}
.adm .b-pos{background:color-mix(in srgb,var(--kimi-color-positive) 14%,transparent);color:var(--kimi-color-positive)}
.adm .b-neg{background:color-mix(in srgb,var(--kimi-color-danger) 14%,transparent);color:var(--kimi-color-danger)}
.adm .b-warn{background:color-mix(in srgb,var(--kimi-color-warning) 16%,transparent);color:color-mix(in srgb,var(--kimi-color-warning) 80%,black)}
.adm .b-info{background:color-mix(in srgb,var(--kimi-color-accent) 13%,transparent);color:var(--kimi-color-accent)}
.adm .b-mut{background:var(--kimi-color-surface-muted);color:var(--kimi-color-text-secondary)}
.adm .act{font-size:12px;border:1px solid var(--kimi-color-border);border-radius:9999px;padding:4px 12px;flex:none;transition:all var(--t-fast)}
.adm .act:hover{border-color:var(--kimi-color-text-primary)}
.adm .act.danger{color:var(--kimi-color-danger);border-color:color-mix(in srgb,var(--kimi-color-danger) 40%,transparent)}
.adm .bar{position:relative}
.adm .bar>i{position:absolute;inset:0;background:color-mix(in srgb,var(--kimi-color-text-primary) 10%,transparent);border-radius:3px}
.adm .bar>b{position:absolute;left:0;top:0;bottom:0;background:var(--kimi-color-text-primary);border-radius:3px;transition:width var(--t-slow) var(--ease-out)}
