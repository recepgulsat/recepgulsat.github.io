.adm .toast.show{opacity:1;transform:translate(-50%,0)}
.adm .num{font-variant-numeric:tabular-nums}
.adm .srow{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--kimi-color-border);font-size:13px}
.adm select{font:inherit;font-size:12px;border:1px solid var(--kimi-color-border);border-radius:8px;padding:4px 8px;background:var(--kimi-color-surface);color:var(--kimi-color-text-primary);outline:none;cursor:pointer}
.adm .ainput{border:1px solid var(--kimi-color-border);border-radius:10px;padding:9px 14px;font-size:13px;background:transparent;color:var(--kimi-color-text-primary);outline:none;font-family:inherit;width:100%}
.adm textarea.ainput{resize:none;line-height:18px}
.adm .livedot{width:8px;height:8px;border-radius:9999px;background:var(--kimi-color-positive);animation:tkp 1.6s infinite}
